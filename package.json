{
  "name": "jworden-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/ops",
    "packages/core",
    "packages/ai",
    "packages/ui"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:ops": "npm run dev --workspace=apps/ops",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:ops": "npm run build --workspace=apps/ops",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:command": "npm --prefix apps/command run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}