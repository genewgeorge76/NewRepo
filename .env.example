# ─── J. Worden & Sons Platform — Environment Variables ───────────────────────
# Copy to .env (root) or app-level .env.local and fill in values.
# NEVER commit real secrets.

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Claude API — primary AI
OPENAI_API_KEY=sk-...                  # OpenAI — vision / fallback
GOOGLE_API_KEY=...                     # Gemini / Google Maps / Places

# ── Site ──────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://www.jwordenasphaltpaving.com
VITE_API_BASE_URL=https://jworden-api.up.railway.app

# ── Backend (apps/api) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/jworden
REDIS_URL=redis://localhost:6379/0
JWORDEN_MASTER_KEY=                    # openssl rand -hex 32
JWT_SECRET_KEY=                        # openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Auth (ops dashboard) ──────────────────────────────────────────────────────
VITE_OPS_PIN_HASH=                     # SHA-256 of PIN; set via setup script

# ── CRM ───────────────────────────────────────────────────────────────────────
KICKSERV_API_KEY=
KICKSERV_ACCOUNT=jworden

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Voice / SMS ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+18045550100
VAPI_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
FROM_EMAIL=no-reply@jwordenasphaltpaving.com

# ── Analytics / Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
VITE_SENTRY_DSN=https://...@sentry.io/...
VITE_GA4_ID=G-...
GA4_PROPERTY_ID=
GSC_SITE_URL=https://www.jwordenasphaltpaving.com

# ── Google Service Account (for GA4 / GSC API access) ────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=          # base64-encoded service account JSON
